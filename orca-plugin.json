{
  "manifestVersion": 1,
  "pluginApi": 1,
  "id": "worktree-flow",
  "publisher": "gilbertlim",
  "name": "Orca Worktree Flow",
  "version": "1.2.2",
  "description": "Orca 워크트리 작업 관리를 위한 초기 설정과 에이전트 상태 알림",
  "author": {
    "name": "gilbert lim"
  },
  "engines": {
    "orca": ">=1.4.0"
  },
  "main": "main.mjs",
  "contributes": {
    "commands": [
      {
        "id": "setup",
        "title": "워크트리 초기 설정 다시 실행",
        "context": "worktree"
      },
      {
        "id": "status",
        "title": "워크트리 현황 알림",
        "context": "global"
      }
    ],
    "events": [
      {
        "on": "worktree.created"
      },
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "events:subscribe"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage"
    }
  ]
}
